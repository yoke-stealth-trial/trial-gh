# Project config (key=value).
#
# The on-disk home for project settings that must be readable without a
# database or a network — anything a git hook, a fresh clone, or an
# offline check needs. It rides the repo, so a pulled commit can change
# the project's stance. Shared behavior that only server-side code reads
# stays in the `project-policy` capability in the database.
#
# Blank lines and lines starting with # are ignored. A trailing `# ...`
# after a value is documentation, not part of the value.
#
# Authored-file line limit, enforced by the pre-commit hook and
# `yoke check file-line`. Unset means 350.
# file_line_limit=350
#
# Authored exceptions remain shrink-only above the limit.
# file_line_exception=src/oversized.py
# Generated or data files may grow. Repeat one repo-relative glob per line.
# file_line_grow_allowed=docs/generated-reference/**

# Yoke-managed rules files. `yoke project install` writes one contiguous
# managed block into each; a project cannot split a region it does not
# own, so the authored-file line limit does not apply to these paths.
# Content you add outside the managed markers is still yours to keep
# readable — the exemption is about the block, not a licence to sprawl.
file_line_grow_allowed=AGENTS.md
